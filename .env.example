# Copy to .env and adjust.

# ── Database ────────────────────────────────────────────────────────────────
# Postgres (event day):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mplbe
# SQLite (quick local dev, no Postgres needed):
# DATABASE_URL=sqlite+aiosqlite:///./mpl.db

ADMIN_PASSCODE=admin123

# ── Frontend pairing ────────────────────────────────────────────────────────
# Folder served at /ui for single-origin running. Empty = ./frontend.
# When the frontend is a separate checkout next to this repo, use:
# FRONTEND_DIR=../MPL-FE

# ── Event clock ─────────────────────────────────────────────────────────────
EVENT_DURATION_SECONDS=7200

# ── Judge backend ───────────────────────────────────────────────────────────
# "piston" -> Piston cloud / local execution engine. Recommended for event day.
# "mock"   -> executes code locally for offline development.
JUDGE_BACKEND=piston
PISTON_URL=https://emkc.org/api/v2/piston/execute

# DEV ONLY. Lets the mock judge really run python for offline testing.
MOCK_EXECUTE_PYTHON=true

# ── Guardrails ──────────────────────────────────────────────────────────────
DEFAULT_CPU_TIME_LIMIT=5
DEFAULT_WALL_TIME_LIMIT=10
DEFAULT_MEMORY_LIMIT_KB=256000
MAX_SOURCE_BYTES=64000

# Protects the judge queue between submits. It is NOT an attempt limit -
# attempts are unlimited.
SUBMIT_COOLDOWN_SECONDS=5
